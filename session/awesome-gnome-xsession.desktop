[Desktop Entry]
Name=Awesome + GNOME
Comment=This session logs you into awesome with GNOME session integration
Exec=gnome-session-awesome
TryExec=awesome-gnome
Type=Application
DesktopNames=ubuntu;GNOME-Flashback;GNOME
X-GDM-SessionRegisters=true
X-GDM-CanRunHeadless=true
X-Ubuntu-Gettext-Domain=gnome-session-46
